// ReUse360 Plus - Prisma Schema - Multi-tenant Sprint 6

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

enum UserRole {
  ADMIN
  ANALYST
  ENFORCEMENT
}

enum OrgPlan {
  TRIAL
  ESSENTIAL
  PROFESSIONAL
  ENTERPRISE
}

enum ViolationType {
  WRONG_DAY
  WRONG_TIME
  EXCESSIVE_USAGE
  CONTINUOUS_FLOW
  LEAK_DETECTED
  PROHIBITED_IRRIGATION
}

enum ViolationStatus {
  DETECTED
  CONFIRMED
  NOTIFIED
  SR_CREATED
  RESOLVED
  DISMISSED
}

enum InspectionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETE
  CANCELLED
  NO_ACCESS
}

enum PermitType {
  IRRIGATION_SYSTEM
  RECLAIMED_CONNECTION
  TEMPORARY_WAIVER
  NEW_LANDSCAPE
}

enum PermitStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  DENIED
  EXPIRED
  REVOKED
}

enum ComplaintSource {
  CUSTOMER_PORTAL
  PHONE
  FIELD_OFFICER
  AMI_TRIGGERED
  HOA
}

enum ComplaintStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  DUPLICATE
  UNFOUNDED
}

enum AlertChannel {
  EMAIL
  SMS
  PUSH
  IN_APP
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum JobType {
  BEACON_RANGE_READ
  BEACON_FLOW_EXPORT
  BEACON_CONSUMPTION
  BEACON_BILLING_READ
  BEACON_INTERVAL_READ
  BEACON_LEAK_EXPORT
  BEACON_ENDPOINT_STATUS
  BEACON_FORMATC_READ
  GIS_PARCEL_SYNC
  VIOLATION_DETECTION
  ALERT_DISPATCH
  CITYWORKS_SR_CREATE
  CITYWORKS_SR_SYNC
}

enum JobStatus {
  QUEUED
  RUNNING
  COMPLETE
  FAILED
  RETRYING
}

enum NotificationType {
  VIOLATION_ALERT
  INSPECTION_DUE
  COMPLIANCE_WARNING
  SYSTEM
  PATROL_REMINDER
}

enum EmailType {
  VIOLATION_NOTICE
  CORRECTION_CONFIRMED
  PROACTIVE_WARNING
}

enum IncentiveType {
  REBATE
  CREDIT
  DISCOUNT
  VOUCHER
}

enum IncentiveStatus {
  PENDING
  APPROVED
  PAID
  DENIED
}

model Organization {
  id           String    @id @default(cuid())
  name         String
  slug         String    @unique
  clerkOrgId   String?   @unique
  plan         OrgPlan   @default(TRIAL)
  trialEndsAt  DateTime?
  isActive     Boolean   @default(true)
  amiApiUrl    String?
  amiApiKey    String?
  gisParcelUrl    String?
  gisViolationUrl String?
  cityworksUrl    String?
  cityworksUser   String?
  sapSystemId     String?
  logoUrl         String?
  primaryColor    String?  @default("#0B6E8C")
  utilityName     String?
  stripeCustomerId     String?  @unique
  stripeSubscriptionId String?  @unique
  seatCount    Int      @default(5)
  accountCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users                 User[]
  parcels               Parcel[]
  customerAccounts      CustomerAccount[]
  violations            Violation[]
  inspections           Inspection[]
  permits               Permit[]
  complaints            Complaint[]
  alerts                Alert[]
  patrolLogs            PatrolLog[]
  wateringZones         WateringZone[]
  parcelZoneAssignments ParcelZoneAssignment[]
  reclaimedIncentives   ReclaimedIncentive[]
  chatSessions          ChatSession[]
  notifications         Notification[]
  connectorJobs         ConnectorJob[]

  @@index([slug])
  @@index([plan])
  @@map("organizations")
}

model User {
  id        String   @id @default(uuid())
  clerkId   String   @unique
  email     String   @unique
  firstName String?
  lastName  String?
  role      UserRole @default(ANALYST)
  isActive  Boolean  @default(true)
  orgId     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org         Organization @relation(fields: [orgId], references: [id])
  inspections Inspection[] @relation("AssignedInspections")
  permits     Permit[]     @relation("IssuedPermits")

  @@index([clerkId])
  @@index([email])
  @@index([orgId])
  @@map("users")
}

model Parcel {
  id                  String   @id @default(uuid())
  parcelId            String
  siteAddress         String
  city                String
  zip                 String
  useCode             String?
  landUseCode         String?
  isHomestead         Boolean  @default(false)
  lat                 Decimal? @db.Decimal(10, 7)
  lon                 Decimal? @db.Decimal(10, 7)
  wateringZone        String?
  irrigationDay       String?
  isReclaimedEligible Boolean  @default(false)
  lastSyncedAt        DateTime @default(now())
  orgId               String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  org              Organization      @relation(fields: [orgId], references: [id])
  customerAccounts CustomerAccount[]

  @@unique([parcelId, orgId])
  @@index([city])
  @@index([wateringZone])
  @@index([orgId])
  @@map("parcels")
}

model CustomerAccount {
  id             String   @id @default(uuid())
  accountId      String
  meterId        String
  parcelId       String
  firstName      String
  lastName       String
  email          String?
  phone          String?
  serviceAddress String
  isReclaimed    Boolean  @default(false)
  isActive       Boolean  @default(true)
  orgId          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  org        Organization         @relation(fields: [orgId], references: [id])
  parcel     Parcel               @relation(fields: [parcelId, orgId], references: [parcelId, orgId])
  violations Violation[]
  alerts     Alert[]
  incentives ReclaimedIncentive[]
  emailLogs  EmailLog[]

  @@unique([accountId, orgId])
  @@index([meterId])
  @@index([parcelId])
  @@index([orgId])
  @@map("customer_accounts")
}

model MeterRead {
  id                String    @id @default(uuid())
  accountId         String
  meterId           String
  readValue         Decimal   @db.Decimal(12, 4)
  readTime          DateTime
  flow              Decimal?  @db.Decimal(12, 4)
  flowUnit          String?   @default("gallons")
  flowTime          DateTime?
  label             String?
  servicePointCycle String?
  resolution        String?
  rawPayload        String?   @db.Text
  createdAt         DateTime  @default(now())

  @@index([meterId, readTime])
  @@index([accountId])
  @@index([readTime])
  @@map("meter_reads")
}
model Violation {
  id              String          @id @default(uuid())
  caseNumber      String?         @unique
  parcelId        String
  accountId       String
  meterId         String
  violationType   ViolationType
  status          ViolationStatus @default(DETECTED)
  detectedAt      DateTime
  confirmedAt     DateTime?
  resolvedAt      DateTime?
  readValue       Decimal         @db.Decimal(12, 4)
  flowUnit        String?         @default("gallons")
  wateringDay     String?
  wateringZone    String?
  ordinanceRef    String?
  cityworksSrId   String?
  notes           String?         @db.Text
  detectedByJobId String?
  orgId           String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  org         Organization    @relation(fields: [orgId], references: [id])
  account     CustomerAccount @relation(fields: [accountId, orgId], references: [accountId, orgId])
  inspections Inspection[]
  complaints  Complaint[]
  alerts      Alert[]
  emailLogs   EmailLog[]

  @@index([parcelId])
  @@index([accountId])
  @@index([status])
  @@index([detectedAt])
  @@index([violationType])
  @@index([orgId])
  @@map("violations")
}

model Inspection {
  id            String           @id @default(uuid())
  violationId   String?
  parcelId      String
  accountId     String
  address       String
  assignedTo    String?
  scheduledDate DateTime?
  completedDate DateTime?
  status        InspectionStatus @default(SCHEDULED)
  findings      String?          @db.Text
  photoUrls     String[]
  cityworksWoId String?
  orgId         String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  org          Organization @relation(fields: [orgId], references: [id])
  violation    Violation?   @relation(fields: [violationId], references: [id])
  assignedUser User?        @relation("AssignedInspections", fields: [assignedTo], references: [id])
  complaints   Complaint[]

  @@index([violationId])
  @@index([parcelId])
  @@index([status])
  @@index([assignedTo])
  @@index([orgId])
  @@map("inspections")
}

model Permit {
  id             String       @id @default(uuid())
  parcelId       String
  accountId      String
  permitType     PermitType
  status         PermitStatus @default(SUBMITTED)
  submittedAt    DateTime     @default(now())
  approvedAt     DateTime?
  expiresAt      DateTime?
  issuedBy       String?
  conditions     String?      @db.Text
  attachmentUrls String[]
  orgId          String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  org          Organization @relation(fields: [orgId], references: [id])
  issuedByUser User?        @relation("IssuedPermits", fields: [issuedBy], references: [id])

  @@index([parcelId])
  @@index([accountId])
  @@index([status])
  @@index([expiresAt])
  @@index([orgId])
  @@map("permits")
}

model Complaint {
  id                String          @id @default(uuid())
  reportedParcelId  String?
  reporterAccountId String?
  address           String
  source            ComplaintSource
  status            ComplaintStatus @default(OPEN)
  description       String          @db.Text
  violationId       String?
  inspectionId      String?
  cityworksSrId     String?
  resolvedAt        DateTime?
  resolution        String?         @db.Text
  orgId             String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  org        Organization @relation(fields: [orgId], references: [id])
  violation  Violation?   @relation(fields: [violationId], references: [id])
  inspection Inspection?  @relation(fields: [inspectionId], references: [id])

  @@index([reportedParcelId])
  @@index([status])
  @@index([violationId])
  @@index([orgId])
  @@map("complaints")
}

model Alert {
  id          String        @id @default(uuid())
  accountId   String
  parcelId    String?
  violationId String?
  severity    AlertSeverity @default(INFO)
  channel     AlertChannel
  subject     String
  body        String        @db.Text
  sentAt      DateTime?
  readAt      DateTime?
  orgId       String
  createdAt   DateTime      @default(now())

  org       Organization    @relation(fields: [orgId], references: [id])
  account   CustomerAccount @relation(fields: [accountId, orgId], references: [accountId, orgId])
  violation Violation?      @relation(fields: [violationId], references: [id])

  @@index([accountId])
  @@index([violationId])
  @@index([sentAt])
  @@index([orgId])
  @@map("alerts")
}

model LeakAlert {
  id                   String        @id @default(uuid())
  accountId            String
  meterId              String
  parcelId             String?
  detectedAt           DateTime
  continuousFlowHours  Decimal?      @db.Decimal(6, 2)
  estimatedLossGallons Decimal?      @db.Decimal(12, 2)
  severity             AlertSeverity @default(WARNING)
  resolvedAt           DateTime?
  violationId          String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([accountId])
  @@index([detectedAt])
  @@map("leak_alerts")
}

model ConnectorJob {
  id              String    @id @default(uuid())
  jobType         JobType
  status          JobStatus @default(QUEUED)
  payload         String?   @db.Text
  result          String?   @db.Text
  errorMessage    String?   @db.Text
  attemptCount    Int       @default(0)
  maxAttempts     Int       @default(3)
  beaconJobUuid   String?
  beaconStatusUrl String?
  scheduledAt     DateTime  @default(now())
  startedAt       DateTime?
  completedAt     DateTime?
  orgId           String
  createdAt       DateTime  @default(now())

  org Organization @relation(fields: [orgId], references: [id])

  @@index([status])
  @@index([jobType])
  @@index([scheduledAt])
  @@index([orgId])
  @@map("connector_jobs")
}

model WateringZone {
  id               String   @id @default(uuid())
  zoneCode         String
  description      String
  allowedDays      String[]
  allowedStartTime String?
  allowedEndTime   String?
  ordinanceRef     String?
  isActive         Boolean  @default(true)
  orgId            String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id])

  @@unique([zoneCode, orgId])
  @@index([orgId])
  @@map("watering_zones")
}

model ParcelZoneAssignment {
  id            String   @id @default(uuid())
  parcelId      String
  zoneId        String
  zoneName      String?
  dayOfWeek     String?
  oddEven       String?
  effectiveDate DateTime @default(now())
  geojson       String?  @db.Text
  source        String?
  orgId         String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id])

  @@unique([parcelId, zoneId, orgId])
  @@index([parcelId])
  @@index([zoneId])
  @@index([effectiveDate])
  @@index([orgId])
  @@map("parcel_zone_assignments")
}
model ReclaimedIncentive {
  id           String          @id @default(uuid())
  accountId    String
  type         IncentiveType
  status       IncentiveStatus @default(PENDING)
  amount       Decimal         @db.Decimal(10, 2)
  description  String?         @db.Text
  appliedAt    DateTime        @default(now())
  approvedAt   DateTime?
  paidAt       DateTime?
  deniedAt     DateTime?
  deniedReason String?         @db.Text
  approvedBy   String?
  orgId        String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  org     Organization    @relation(fields: [orgId], references: [id])
  account CustomerAccount @relation(fields: [accountId, orgId], references: [accountId, orgId])

  @@index([accountId])
  @@index([status])
  @@index([type])
  @@index([appliedAt])
  @@index([orgId])
  @@map("reclaimed_incentives")
}

model PatrolLog {
  id                  String   @id @default(cuid())
  officerNames        String[]
  patrolDate          DateTime
  mileage             Float    @default(0)
  startOdometer       Float?
  endOdometer         Float?
  totalMiles          Float?
  vehicleId           String?
  numberOfViolations  Int      @default(0)
  citationsIssued     Int      @default(0)
  warningsIssued      Int      @default(0)
  violationOccurred   Boolean  @default(false)
  outreachConducted   Boolean  @default(false)
  outreachType        String?
  pamphletCount       Int      @default(0)
  residencesContacted Int      @default(0)
  waterSource         String?
  notes               String?  @db.Text
  shiftStart          String?
  shiftEnd            String?
  submittedById       String?
  orgId               String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id])

  @@index([patrolDate])
  @@index([submittedById])
  @@index([orgId])
  @@map("patrol_logs")
}

model ParcelLookup {
  id         String   @id @default(cuid())
  officerId  String
  query      String
  resultData String   @db.Text
  createdAt  DateTime @default(now())

  @@index([officerId])
  @@index([createdAt])
  @@map("parcel_lookups")
}

model ChatSession {
  id        String   @id @default(cuid())
  userId    String?
  userEmail String?
  orgId     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ChatMessage[]
  org      Organization? @relation(fields: [orgId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@index([orgId])
  @@map("chat_sessions")
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      String
  content   String   @db.Text
  createdAt DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([createdAt])
  @@map("chat_messages")
}

model RagDocument {
  id         String   @id @default(cuid())
  title      String
  content    String   @db.Text
  sourceType String
  sourceId   String?
  chunkIndex Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([sourceType])
  @@index([createdAt])
  @@map("rag_documents")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String           @db.Text
  type      NotificationType
  read      Boolean          @default(false)
  link      String?
  orgId     String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  org Organization @relation(fields: [orgId], references: [id])

  @@index([userId])
  @@index([userId, read])
  @@index([createdAt])
  @@index([orgId])
  @@map("notifications")
}

model EmailLog {
  id          String    @id @default(uuid())
  violationId String?
  accountId   String
  emailType   EmailType
  recipient   String
  subject     String
  resendId    String?
  status      String    @default("SENT")
  errorMsg    String?
  sentBy      String?
  orgId       String
  sentAt      DateTime  @default(now())
  createdAt   DateTime  @default(now())

  violation Violation?      @relation(fields: [violationId], references: [id])
  account   CustomerAccount @relation(fields: [accountId, orgId], references: [accountId, orgId])

  @@index([violationId])
  @@index([accountId])
  @@index([sentAt])
  @@index([emailType])
  @@map("email_logs")
}